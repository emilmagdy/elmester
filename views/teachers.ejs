<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="تصفح قائمة أشهر مدرسي المواد المختلفة في مصر، واقرأ تقييمات الطلاب الحقيقية لمساعدتك في اختيار المدرس الأفضل لك في الفيزياء، الكيمياء، العربي وغيرها.">
    <title>منصة المستر - قائمة المدرسين</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
        }

        .custom-border-right {
            border-right: 5px solid #3498db;
        }

        .teacher-card {
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .teacher-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05) !important;
        }

        @media (min-width: 768px) {
            .vertical-divider {
                border-right: 1px solid #dee2e6;
                padding-right: 20px;
            }
        }
    </style>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JY6XG2MXHM"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-JY6XG2MXHM');
    </script>
    
    <!-- Meta Pixel Code -->
    <script>!function (f, b, e, v, n, t, s) { if (f.fbq) return; n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments) }; if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = []; t = b.createElement(e); t.async = !0; t.src = v; s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s) }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js'); fbq('init', '26540915822251415'); fbq('track', 'PageView');</script>
    <noscript>
        <img height="1" width="1" src="https://www.facebook.com/tr?id=26540915822251415&ev=PageView&noscript=1" />
    </noscript>
    <!-- End Meta Pixel Code -->
</head>

<body>
    <%- include('partials/header') %>

    <main class="container my-5">
        <div class="mb-4">
            <a href="/" class="btn btn-outline-secondary btn-sm">⬅️ العودة للصفحة الرئيسية</a>
        </div>
        
        <%- include('partials/_messages') %>

        <div class="container my-4 p-0">
            <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap m-0 shadow-sm border-0">
                <span class="mb-2 mb-md-0">
                    🔍 <strong>مش لاقي المدرس بتاعك؟</strong> ساعدنا نكبر المنصة واقترح المدرس المفضل ليك!
                </span>
                <a href="/suggest-teacher" class="btn btn-info text-white fw-bold px-4">اقترح مدرس الآن 💡</a>
            </div>
        </div>

        <h1 class="text-center text-dark fw-bold mb-5">قائمة المدرسين المسجلين في منصة المستر 🎓</h1>

        <div class="card mb-4 border-0 shadow-sm bg-light rounded-0">
            <div class="card-body p-3">
                <form action="/teachers" method="GET" id="filterForm" class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <label class="form-label small text-secondary fw-bold mb-1">🔍 فلترة بحسب المادة الدراسية:</label>
                        <select name="subject" class="form-select form-select-sm rounded-0" onchange="document.getElementById('filterForm').submit()">
                            <option value="all" <%= selectedSubject === 'all' ? 'selected' : '' %>>كل المواد الدراسية</option>
                            <% subjects.forEach(sub => { %>
                                <option value="<%= sub %>" <%= selectedSubject === sub ? 'selected' : '' %>><%= sub %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-md-5">
                        <label class="form-label small text-secondary fw-bold mb-1">📊 ترتيب النتائج بحسب:</label>
                        <select name="sort" class="form-select form-select-sm rounded-0" onchange="document.getElementById('filterForm').submit()">
                            <option value="default" <%= selectedSort === 'default' ? 'selected' : '' %>>الترتيب الافتراضي (الاسم)</option>
                            <option value="rating_desc" <%= selectedSort === 'rating_desc' ? 'selected' : '' %>>التقييم الأعلى أولاً ⭐</option>
                            <option value="rating_asc" <%= selectedSort === 'rating_asc' ? 'selected' : '' %>>التقييم الأقل أولاً</option>
                        </select>
                    </div>
                </form>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-11">
                <% teachers.forEach(teacher => { %>
                    <div class="card mb-4 shadow-sm border-0 bg-white p-4 teacher-card custom-border-right">
                        <div class="row align-items-center g-3">
                            <div class="col-md-9">
                                <div class="d-flex flex-column flex-sm-row align-items-center justify-content-start gap-4">
                                    <div class="flex-shrink-0">
                                        <img src="<%= teacher.photo_url %>" class="rounded border shadow-sm" alt="<%= teacher.name %>" style="width: 110px; height: 110px; object-fit: cover;">
                                    </div>

                                    <div class="flex-grow-1 text-center text-sm-start">
                                        <h2 class="fw-bold text-dark mb-1 fs-5"><%= teacher.name %></h2>
                                        <span class="badge bg-success text-white px-3 py-1 rounded-pill fs-7 mb-2 d-inline-block">
                                            📚 <%= teacher.subject %>
                                        </span>

                                        <div class="d-flex flex-wrap justify-content-center justify-content-sm-start gap-2 mt-1">
                                            <% if (teacher.facebook_url) { %>
                                                <a href="<%= teacher.facebook_url %>" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill py-0 px-2 fs-7 fw-semibold">
                                                    <i class="bi bi-facebook"></i> صفحة المدرس 🔗
                                                </a>
                                            <% } %>
                                            <% if (teacher.website_url) { %>
                                                <a href="<%= teacher.website_url %>" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill py-0 px-2 fs-7 fw-semibold">
                                                    <i class="bi bi-globe"></i> المنصة الخاصة 🌐
                                                </a>
                                            <% } %>
                                            <% if (teacher.youtube_url) { %>
                                                <a href="<%= teacher.youtube_url %>" target="_blank" class="btn btn-outline-danger btn-sm rounded-pill py-0 px-2 fs-7 fw-semibold d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-youtube text-danger"></i> قناة اليوتيوب 📺
                                                </a>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-column align-items-center justify-content-center flex-shrink-0 text-center px-sm-4 vertical-divider">
                                        <div class="text-warning mb-1">
                                            <span class="fs-4 fw-bold"><%= teacher.avg_rating %></span> ★
                                        </div>
                                        <small class="text-muted d-block mb-2">(متوسط <%= teacher.total_reviews %> تقييم)</small>
                                        <a href="/teachers/<%= teacher.id %>/<%= teacher.subject_slug %>/<%= teacher.study_type %>/<%= teacher.teacher_slug %>" class="btn btn-outline-primary btn-sm px-3 fw-semibold rounded-pill">
                                            👁️ عرض التقييمات
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 d-flex align-items-center justify-content-center border-start-md">
                                <div class="w-100 text-center">
                                    <% if (typeof userSession !== 'undefined' && userSession && userSession.userId) { %>
                                        <div class="p-2 bg-light rounded border text-start">
                                            <h6 class="text-secondary mb-2 fw-bold" style="font-size: 0.85rem;">إضافة تقييمك:</h6>
                                            <form action="/teachers/<%= teacher.id %>/review" method="POST">
                                                <div class="mb-2">
                                                    <select name="rating" class="form-select form-select-sm" required>
                                                        <option value="" disabled selected>اختر التقييم...</option>
                                                        <option value="5">⭐⭐⭐⭐⭐ ممتاز (5)</option>
                                                        <option value="4">⭐⭐⭐⭐ جيد جداً (4)</option>
                                                        <option value="3">⭐⭐⭐ جيد (3)</option>
                                                        <option value="2">⭐⭐ مقبول (2)</option>
                                                        <option value="1">⭐ ضعيف (1)</option>
                                                    </select>
                                                </div>
                                                <div class="mb-2">
                                                    <textarea name="review_text" class="form-control form-control-sm" rows="2" placeholder="اكتب رأيك هنا (اختياري)..." maxlength="500"></textarea>
                                                </div>
                                                <button type="submit" class="btn btn-primary btn-sm w-100"> ✍️ إرسال التقييم </button>
                                            </form>
                                        </div>
                                    <% } else { %>
                                        <div class="py-2">
                                            <div class="text-muted small mb-1">
                                                <i class="bi bi-star text-warning"></i> قيم هذا المدرس
                                            </div>
                                            <button type="button" class="btn btn-outline-dark btn-sm fw-bold px-3 shadow-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#loginPromptModal">
                                                🔒 سجل دخولك للتقييم
                                            </button>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <div class="modal fade" id="loginPromptModal" tabindex="-1" aria-labelledby="loginPromptModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="loginPromptModalLabel">🎓 منصة المستر</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <div class="fs-1 text-warning mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">خطوة واحدة تفصلك عن التقييم</h5>
                    <p class="text-muted small">عشان نضمن مصداقية التقييمات ومحدش يكرر تقييمه، لازم تسجل دخولك الأول في ثواني معدودة!</p>
                </div>
                <div class="modal-footer d-flex gap-2 justify-content-center border-0 pb-4">
                     <a href="/auth/google"
                    class="btn btn-light btn-sm px-2 px-sm-3 fw-bold d-flex align-items-center gap-2 shadow-sm border">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 48 48">
                        <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z" />
                        <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z" />
                        <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z" />
                        <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z" />
                    </svg>
                    <span>تسجيل دخول بواسطة جوجل </span>
                </a>
                    <a href="/login" class="btn btn-primary px-4 fw-bold">تسجيل الدخول</a>
                    <a href="/register" class="btn btn-outline-dark px-4">إنشاء حساب جديد</a>
                    
                </div>
                
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>