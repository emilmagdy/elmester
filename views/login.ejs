<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="سجل دخولك الآن إلى حسابك على منصة المستر لمتابعة أحدث تقييمات المدرسين وإضافة تقييمك ورأيك الخاص لمساعدة زملائك.">
    <title>المستر - تسجيل الدخول</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <style>
        body {
            background-color: #f8f9fa;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .login-container {
            max-width: 450px;
            width: 100%;
            margin: auto;
            padding: 20px;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }

        .btn-primary {
            background-color: #0d6efd;
            border: none;
            border-radius: 8px;
            padding: 12px;
            font-weight: bold;
        }

        .btn-primary:hover {
            background-color: #0b5ed7;
        }

        /* تنسيق زر جوجل ليكبر ويظهر كزر رسمي ممتاز */
        .btn-google {
            background-color: #ffffff;
            color: #3c4043;
            border: 1px solid #dadce0;
            border-radius: 8px;
            padding: 12px 16px;
            font-size: 1.05rem;
            font-weight: 600;
            transition: background-color 0.2s, box-shadow 0.2s;
        }

        .btn-google:hover {
            background-color: #f8f9fa;
            color: #1a73e8;
            border-color: #d2e3fc;
            box-shadow: 0 2px 8px rgba(60, 64, 67, 0.15) !important;
        }
    </style>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JY6XG2MXHM"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-JY6XG2MXHM');
    </script>
    <!-- Meta Pixel Code -->
    <script>!function (f, b, e, v, n, t, s) { if (f.fbq) return; n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments) }; if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = []; t = b.createElement(e); t.async = !0; t.src = v; s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s) }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js'); fbq('init', '26540915822251415'); fbq('track', 'PageView');</script>
    <noscript>
        <img height="1" width="1" src="https://www.facebook.com/tr?id=26540915822251415&ev=PageView&noscript=1" />
    </noscript>
    <!-- End Meta Pixel Code -->
</head>

<body>

    <%- include('partials/header') %>

        <div class="container login-container my-5">
            <div class="card p-4 p-sm-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-dark">تسجيل الدخول</h2>
                    <p class="text-muted small">مرحباً بك مجدداً في منصة مستشارك التعليمية</p>
                </div>
                <%- include("partials/_messages") %>
                
                    <!-- زر جوجل بتصميم أكبر وأوضح -->
                    <div class="mb-3">
                        <a href="/auth/google"
                            class="btn btn-google w-100 d-flex align-items-center justify-content-center gap-2 shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 48 48">
                                <path fill="#FFC107"
                                    d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z" />
                                <path fill="#FF3D00"
                                    d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z" />
                                <path fill="#4CAF50"
                                    d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z" />
                                <path fill="#1976D2"
                                    d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z" />
                            </svg>
                            <span>المتابعة باستخدام Google</span>
                        </a>
                    </div>

                    <!-- فاصل بصري بسيط بين جوجل والتسجيل العادي -->
                    <div class="d-flex align-items-center my-3">
                        <hr class="flex-grow-1 m-0 text-muted">
                        <span class="px-2 text-muted small">أو</span>
                        <hr class="flex-grow-1 m-0 text-muted">
                    </div>

                    <form action="/login" method="POST" class="needs-validation" novalidate>

                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="floatingEmail" name="email"
                                placeholder="name@example.com" required>
                            <label for="floatingEmail">البريد الإلكتروني</label>
                            <div class="invalid-feedback">برجاء إدخال بريد إلكتروني صحيح.</div>
                        </div>

                        <div class="form-floating mb-4">
                            <input type="password" class="form-control" id="floatingPassword" name="password"
                                placeholder="Password" required>
                            <label for="floatingPassword">كلمة المرور</label>
                            <div class="invalid-feedback">برجاء إدخال كلمة المرور.</div>
                        </div>

                        <button class="w-100 btn btn-lg btn-primary mb-3" type="submit">دخول الحساب</button>

                        <div class="text-center mt-3">
                            <span class="text-muted small">ليس لديك حساب؟</span>
                            <a href="/register" class="text-decoration-none small fw-bold">إنشاء حساب جديد</a>
                        </div>
                    </form>
            </div>
        </div>

        <%- include('partials/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script>
                // Standard Bootstrap client-side form validation injection logic
                (() => {
                    'use strict'
                    const forms = document.querySelectorAll('.needs-validation')
                    Array.from(forms).forEach(form => {
                        form.addEventListener('submit', event => {
                            if (!form.checkValidity()) {
                                event.preventDefault()
                                event.stopPropagation()
                            }
                            form.classList.add('was-validated')
                        }, false)
                    })
                })()
            </script>
</body>

</html>