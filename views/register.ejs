<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="أنشئ حسابك مجاناً على منصة المستر وانضم لزملائك لمشاركة تجربتك وتقييم مدرسيك بكل صراحة لمساعدة الطلاب الآخرين في اختيار الأنسب لهم.">
    <title>إنشاء حساب جديد | المستر</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <%- include('partials/head') %>

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .signup-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 0;
        }

        .signup-container {
            max-width: 500px;
            width: 90%;
        }

        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        }

        .card-header {
            background-color: transparent;
            border-bottom: none;
            padding-top: 30px;
        }

        .btn-primary {
            border-radius: 10px;
            padding: 12px;
            font-weight: 700;
            background-color: #0d6efd;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #0b5ed7;
            transform: translateY(-2px);
        }

        .btn-google {
            border-radius: 10px;
            padding: 11px;
            font-weight: 700;
            background-color: #ffffff;
            color: #374151;
            border: 1px solid #d1d5db;
            transition: all 0.3s ease;
        }

        .btn-google:hover {
            background-color: #f9fafb;
            border-color: #9ca3af;
            transform: translateY(-2px);
            color: #111827;
        }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            color: #6c757d;
            margin: 20px 0;
            font-size: 0.9rem;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #dee2e6;
        }

        .divider:not(:empty)::before {
            margin-left: .5em;
        }

        .divider:not(:empty)::after {
            margin-right: .5em;
        }

        .form-floating>label {
            right: 0;
            left: auto;
            padding-right: 1.25rem;
        }

        .form-floating>.form-control:focus~label,
        .form-floating>.form-control:not(:placeholder-shown)~label,
        .form-floating>.form-select~label {
            transform: scale(.85) translateY(-0.5rem) translateX(-0.5rem);
        }
    </style>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JY6XG2MXHM"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-JY6XG2MXHM');
    </script>
    <!-- Meta Pixel Code -->
    <script>!function (f, b, e, v, n, t, s) { if (f.fbq) return; n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments) }; if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = []; t = b.createElement(e); t.async = !0; t.src = v; s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s) }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js'); fbq('init', '26540915822251415'); fbq('track', 'PageView');</script>
    <noscript>
        <img height="1" width="1" src="https://www.facebook.com/tr?id=26540915822251415&ev=PageView&noscript=1" />
    </noscript>
    <!-- End Meta Pixel Code -->
</head>

<body>
    <%- include('partials/header') %>

        <div class="signup-wrapper">
            <div class="signup-container">
                <div class="card p-4">
                    <div class="card-header text-center">
                        <h2 class="fw-bold text-primary">إنشاء حساب</h2>
                        <p class="text-muted">انضم لزملائك في "منصة المستر" التعليمية</p>
                    </div>
                    <div class="card-body">
                        <%- include('partials/_messages') %>

                            <div class="mb-3">
                                <a href="/auth/google" class="btn btn-google w-100 d-flex align-items-center justify-content-center gap-2 shadow-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                                        <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z" />
                                        <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z" />
                                        <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z" />
                                        <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z" />
                                    </svg>
                                    <span>التسجيل بواسطة Google</span>
                                </a>
                            </div>

                            <div class="divider">أو باستخدام البريد الإلكتروني</div>

                            <form action="/register" method="POST" class="needs-validation" novalidate>

                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="name" name="name" placeholder="الاسم الكامل" required>
                                    <label for="name">الاسم الكامل</label>
                                    <div class="invalid-feedback">من فضلك أدخل اسمك الحقيقي.</div>
                                </div>

                                <div class="form-floating mb-3">
                                    <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
                                    <label for="email">البريد الإلكتروني</label>
                                    <div class="invalid-feedback">من فضلك أدخل بريد إلكتروني صحيح.</div>
                                </div>

                                <div class="form-floating mb-3">
                                    <input type="password" class="form-control" id="password" name="password" placeholder="كلمة المرور" required minlength="6">
                                    <label for="password">كلمة المرور</label>
                                    <div class="invalid-feedback">كلمة المرور يجب أن لا تقل عن 6 أحرف.</div>
                                </div>

                                <div class="form-floating mb-4">
                                    <select class="form-select" id="grade" name="grade" required>
                                        <option value="" selected disabled>اختر سنتك الدراسية</option>
                                        <option value="1">الصف الأول الثانوي</option>
                                        <option value="2">الصف الثاني الثانوي</option>
                                        <option value="3">الصف الثالث الثانوي</option>
                                    </select>
                                    <label for="grade">السنة الدراسية</label>
                                    <div class="invalid-feedback">من فضلك اختر سنتك الدراسية.</div>
                                </div>

                                <div class="d-grid mb-3">
                                    <button type="submit" class="btn btn-primary">إنشاء الحساب الآن 🚀</button>
                                </div>

                                <div class="text-center mt-3">
                                    <span class="text-muted">لديك حساب بالفعل؟</span>
                                    <a href="/login" class="text-decoration-none fw-bold">تسجيل الدخول</a>
                                </div>

                            </form>
                    </div>
                </div>
            </div>
        </div>

        <%- include('partials/footer') %>

            <script>
                (() => {
                    'use strict'
                    const forms = document.querySelectorAll('.needs-validation')
                    Array.from(forms).forEach(form => {
                        form.addEventListener('submit', event => {
                            if (!form.checkValidity()) {
                                event.preventDefault()
                                event.stopPropagation()
                            }
                            form.classList.add('was-validated')
                        }, false)
                    })
                })()
            </script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>